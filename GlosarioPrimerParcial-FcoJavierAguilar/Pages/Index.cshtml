@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 style="color: #333; margin-bottom: 10px; font-size: 2.5rem;">Glosario Técnico del Primer Parcial</h1>
    <p style="color: #666; font-size: 1.2rem; margin-bottom: 50px;">Elige el lenguaje que desees consultar o agregar un nuevo término.</p>

    <!--- Contenedor de Tarjetas -->
    <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">

        <!-- Tarjeta de HTML -->
        <a href="/Html" style="text-decoration: none; color: inherit; width: 250px; border: 2px solid #e34c26; border-radius: 12px; padding: 30px 20px; text-align: center; background-color: #fffaf9; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <h2 style="color: #e34c26; margin-top: 0; font-size: 2rem;">HTML</h2>
            <p style="color: #555; margin-bottom:25px;">Etiquetas base de estructura, text y creación de fórmularios.</p>
            <span style="display: inline-block; padding: 10px 20px; background-color: #e34c26; color:white; border-radius: 5px; font-weight: bold;">Acceder</span>
        </a>

        <!-- Tarjeta de CSS -->
        <a href="/Css" style="text-decoration: none; color: inherit; width: 250px; border: 2px solid #264de4; border-radius: 12px; padding: 30px 20px; text-align: center; background-color: #f4f7ff; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <h2 style="color: #264de4; margin-top: 0; font-size: 2rem;">CSS</h2>
            <p style="color: #555; margin-bottom:25px;">Propiedades de diseño, alineación Flexbox y estilos visuales.</p>
            <span style="display: inline-block; padding: 10px 20px; background-color: #264de4; color:white; border-radius: 5px; font-weight: bold;">Acceder</span>
        </a>

        <!-- Tarjeta de C# -->
        <a href="/Csharp" style="text-decoration: none; color: inherit; width: 250px; border: 2px solid #512bd4; border-radius: 12px; padding: 30px 20px; text-align: center; background-color: #f9f8fc; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <h2 style="color: #512bd4; margin-top: 0; font-size: 2rem;">C#</h2>
            <p style="color: #555; margin-bottom:25px;">Lógica de negocio, clases, encapsulamiento y manejadores HTTP.</p>
            <span style="display: inline-block; padding: 10px 20px; background-color: #512bd4; color:white; border-radius: 5px; font-weight: bold;">Acceder</span>
        </a>
    </div>
</div>